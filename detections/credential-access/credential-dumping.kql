// =============================================================================
// Detection    : Credential dumping (LSASS memory, SAM/SECURITY hives, NTDS.dit)
// Hypothesis   : An attacker with admin rights dumps credentials so they can reuse
//                another account's password or hash to move further.
// ATT&CK       : T1003.001 OS Credential Dumping: LSASS Memory
//                T1003.002 Security Account Manager
//                T1003.003 NTDS
//                Tactic: Credential Access
// Data source  : DeviceProcessEvents
// Severity     : High
// Scope        : Lab detection written against synthetic telemetry.
// -----------------------------------------------------------------------------
// Covers the common built-in or well-known techniques:
//   procdump -ma lsass                      (Sysinternals, often renamed)
//   rundll32 comsvcs.dll MiniDump <lsass pid> (no extra tools needed)
//   reg save HKLM\SAM / SECURITY / SYSTEM   (offline hash extraction)
//   ntdsutil "ac i ntds" ifm / vssadmin + copy ntds.dit (domain controller)
//   mimikatz-style keywords in the command line
// -----------------------------------------------------------------------------
// False positives : Troubleshooting dumps by support staff (procdump), backup
//                   software saving registry hives, and authorised DC backups
//                   (ntdsutil ifm). All should be rare and pre-approved.
// Response        : Treat as High. Isolate the host, identify every account that
//                   was logged on to it (all may be compromised), reset those
//                   credentials, and for NTDS.dit assume full domain compromise.
// Validation      : Not yet validated against live telemetry.
// =============================================================================
let lookback = 7d;
DeviceProcessEvents
| where Timestamp > ago(lookback)
| where
    // LSASS memory dumps
    ((FileName in~ ("procdump.exe", "procdump64.exe")
        or ProcessVersionInfoOriginalFileName =~ "procdump")
        and ProcessCommandLine has "lsass")
    or (FileName =~ "rundll32.exe" and ProcessCommandLine has "comsvcs" and ProcessCommandLine has "minidump")
    // Registry hive export for offline cracking
    or (FileName =~ "reg.exe" and ProcessCommandLine has "save"
        and ProcessCommandLine matches regex @"(?i)hklm\\(sam|security|system)\b")
    // NTDS.dit extraction on domain controllers
    or (FileName =~ "ntdsutil.exe" and ProcessCommandLine has "ifm")
    or (ProcessCommandLine has "ntds.dit" and FileName in~ ("cmd.exe", "powershell.exe", "esentutl.exe", "robocopy.exe"))
    // Mimikatz-style modules typed on the command line
    or ProcessCommandLine has_any ("sekurlsa", "lsadump", "kerberos::")
| extend Technique = case(
    ProcessCommandLine has "lsass" or ProcessCommandLine has "minidump" or ProcessCommandLine has "sekurlsa", "T1003.001 LSASS",
    ProcessCommandLine has "ntds", "T1003.003 NTDS",
    FileName =~ "reg.exe", "T1003.002 SAM",
    "T1003")
| project Timestamp, DeviceName, AccountName, Technique, FileName, ProcessCommandLine,
          InitiatingProcessFileName
| order by Timestamp desc


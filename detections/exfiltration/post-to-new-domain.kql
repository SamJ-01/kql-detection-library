// | where TimeGenerated > ago(1d)
// | where RequestMethod == "POST"
// | summarize SentMB = sum(SentBytes) / 1048576.0, Requests = count()
//             by SourceIP, DestinationHostName
// | where SentMB > threshold_mb
// | order by SentMB desc
